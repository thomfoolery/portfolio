---
import { LEADER } from '@/data/grid'

/**
 * One dotted row: the label, the leader that fills the gap between, and the
 * value in a 25ch column. A role and a project are the same row, only indented
 * differently — a role indents the row, a project indents the list holding it.
 *
 * The row is laid out in `white-space: pre`, so the markup stays on one line and
 * the formatter is held off it. See AGENTS.md.
 *
 * Below the `wide` breakpoint there is no room for the 25ch column, so the
 * value drops under the label, indented, and the leader goes.
 */
interface Props {
  label: string
  value?: string
  class?: string
}

const { label, value, class: className } = Astro.props
---

{/* prettier-ignore */}
<p class:list={['flex max-wide:flex-col leading-[2]', className]}>
  <span class="mr-[1ch] shrink-0">{label}</span>
  <span class="grow overflow-hidden whitespace-nowrap text-green-100 max-wide:hidden" aria-hidden="true">{LEADER}</span>
  <span class="ml-[2ch] wide:ml-[1ch] wide:w-[25ch] shrink-0">{value}</span>
</p>
