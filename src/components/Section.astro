---
/**
 * One panel of the page: a full viewport tall with its content centred in it.
 *
 * The element is configurable so the header and footer can share the same
 * rhythm as the sections without pretending to be `<section>`s. Only the
 * sections take the space below their content; the header and footer keep their
 * own alignment.
 */
type Align = 'top' | 'center' | 'bottom'

interface Props {
  as?: 'section' | 'header' | 'footer' | 'div'
  id?: string
  labelledby?: string
  hidden?: boolean
  align?: Align
  class?: string
}

const {
  as = 'section',
  id,
  labelledby,
  hidden = false,
  align = 'top',
  class: className,
} = Astro.props

const Tag = as
const justify = { top: 'justify-start', center: 'justify-center', bottom: 'justify-end' }[align]

/**
 * What each element adds to the shared panel classes. Only the sections and the
 * footer are flex columns; the header stays in flow, so its art can tuck the nav
 * up under it.
 */
const perElement = {
  header: '-mb-3',
  section: ['flex flex-col pb-[50dvh]', justify],
  footer: ['flex flex-col pb-2', justify],
  div: '',
}[as]
---

<Tag
  id={id}
  aria-labelledby={labelledby}
  hidden={hidden || undefined}
  class:list={['min-h-dvh pt-2', perElement, className]}
>
  <slot />
</Tag>
