---
import { getImage } from 'astro:assets'
import { work } from '@/data/work'
import { springCurve } from '@/lib/spring'
import Button from '@/components/ui/Button.astro'

// A tile shows its poster, made a WebP at its own size. The tile and its enlarged
// video take the poster's shape, as `ratio`.
const tiles = await Promise.all(
  work.map(async (item) => ({
    ...item,
    ratio: `${item.poster.width} / ${item.poster.height}`,
    pixels: (await getImage({ src: item.poster, format: 'webp' })).src,
  })),
)

// A tile zooms on the page's spring, worked out here and handed to the script on
// the overlay, so the script ships without the solver.
const { duration, easing } = springCurve(0.4)

// At either end a step is dimmed rather than disabled: a disabled button drops
// focus, so stepping to the end from the keyboard would lose your place.
const step =
  'aria-disabled:cursor-default aria-disabled:text-green-200 aria-disabled:hover:bg-transparent aria-disabled:hover:text-green-200'
---

<section id="work" aria-labelledby="work-title" class="mt-4">
  <div class="mx-auto wide:max-w-[72ch]">
    <h2 id="work-title" class="sr-only font-bold">
      Work
    </h2>

    <p class="mt-2">Click to inspect</p>
  </div>

  <div class="mt-0.5 w-full overflow-x-clip border-y border-green-100 bg-green-100/25 py-1">
    <div
      id="work-tiles"
      data-work-tiles
      class="flex w-full snap-x [scrollbar-color:transparent_transparent] gap-1 overflow-x-scroll px-[calc((100vw-72ch)/2)]"
    >
      {/* A tile is a button that enlarges its video. What enlarges is the
        frame: the pixels, with the video over them, hidden until it plays. The
        tile draws the same pixels, so it is not left empty while the frame is
        away. The focus ring is drawn inside it: the scroller clips anything
        outside. */}
      {tiles.map((item) => (
        <button
          type="button"
          data-work-tile
          data-work-title={item.title}
          aria-label={`Enlarge ${item.title}`}
          style={`aspect-ratio: ${item.ratio}; background-image: url(${item.pixels})`}
          class="relative h-15 cursor-zoom-in! snap-start scroll-ml-[calc((100vw-72ch)/2)] bg-green-100 bg-cover focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-green-900"
        >
          <span
            data-work-frame
            style={`--ratio: ${item.ratio}; background-image: url(${item.pixels})`}
            class="border border-green-100 bg-cover"
          >
            <video
              src={item.video}
              aria-label={item.title}
              muted
              loop
              playsinline
              preload="none"
              class="h-full w-full object-cover"
            />
          </span>
        </button>
      ))}
    </div>

    {/* Steps the carousel a tile at a time, to the next snap either way. */}
  </div>

  <p
    data-work-steps
    class="mx-auto mt-0.5 flex justify-between gap-x-2 leading-loose wide:max-w-[72ch]"
  >
    <Button
      data-work-step="-1"
      aria-controls="work-tiles"
      aria-label="Previous"
      aria-disabled="true"
      class={step}
    >
      [ &lt;&lt; ]
    </Button>
    {/* The current tile's title, between the steps. The box clips and centres;
          the script keeps one span per name in it and takes the outgoing one out
          of flow, so the two can cross without the row shifting. */}
    <span
      data-work-caption
      class="relative flex-1 overflow-clip text-center whitespace-nowrap"
      aria-hidden="true"
    >
      <span class="block font-black text-green-900 uppercase">{work[0]?.title}</span>
    </span>
    <Button data-work-step="1" aria-controls="work-tiles" aria-label="Next" class={step}>
      [ &gt;&gt; ]
    </Button>
  </p>

  {/* The enlarged video's overlay. It sits outside the carousel, whose reveal
    would fade it and whose scroller would clip it, and it is not a <dialog>:
    a modal draws over everything, the caret included, and the page hides the
    system pointer. The script moves the tile's own frame in and out of it. */}
  <div
    data-work-zoom
    data-duration={duration}
    data-easing={easing}
    role="dialog"
    aria-modal="true"
    tabindex="-1"
    hidden
    class="zoom fixed inset-0 z-(--z-zoom) flex items-center justify-center p-2 outline-none"
  >
    <div data-work-backdrop class="absolute inset-0 bg-black/90"></div>
  </div>
</section>

<style>
  /* A tile, and the frame it enlarges, is a duotone: the poster, drawn without
     smoothing, under a tint whose `color` blend keeps the poster's luminance and
     gives it green-900's hue and saturation. */
  [data-work-tile],
  [data-work-frame] {
    image-rendering: pixelated;
  }
  [data-work-tile]::before,
  [data-work-frame]::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-green-900);
    mix-blend-mode: color;
    pointer-events: none;
  }
  /* Over the tile's own pixels, which show only while it is away. */
  [data-work-frame] {
    position: absolute;
    inset: 0;
  }
  /* The loop, in its own colour, over the pixels: the script fades it in once
     the frame is enlarged and the loop has a picture, and out before it leaves. */
  [data-work-frame] video {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  /* Over a tile the pointer is the platform's magnifier, so the page's caret
     steps aside — the same bargain the dev lab makes over its panel. */
  html[data-cursor] [data-work-tile] {
    cursor: zoom-in!;
  }
  /*html:has([data-work-tile]:hover) :global([data-caret]) {
    visibility: hidden;
  }*/

  /* Enlarged, a frame keeps its tile's shape and is as large as fits inside the
     overlay's padding of two lines a side, over the backdrop. The shape is
     `--ratio` on the frame itself, since it leaves the tile. Its transform starts
     from the top left, which is what the script's zoom is worked out from. */
  .zoom [data-work-frame] {
    position: relative;
    inset: auto;
    width: min(100%, calc((100dvh - var(--spacing) * 4) * var(--ratio)));
    aspect-ratio: var(--ratio);
    transform-origin: 0 0;
  }
</style>

<script>
  import '@/scripts/work'
</script>
