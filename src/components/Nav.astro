---
import hotkeys from './hotkeys.js?raw'
import { navItems } from '@/data/nav'
---

<nav aria-label="Main" class="sticky top-0 bg-black pt-[1rem] shadow-black">
  <ul class="flex flex-wrap gap-x-[2ch]">
    {navItems.map((item) => (
      <li class={item.right ? 'ml-auto' : undefined}>
        {item.key && (
          <span class="hint" aria-hidden="true">
            [{item.key}]
          </span>
        )}
        <a
          class="no-underline py-[3px] px-[1ch]"
          href={item.href}
          title={item.title}
          target={item.external ? '_blank' : undefined}
          data-key={item.key}
          aria-keyshortcuts={item.key}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
<!-- The nav's hotkeys are the page's only client script. Inlined, so no request. -->
{/* eslint-disable-next-line astro/no-set-html-directive -- this is our own script text */}
<script is:inline set:html={hotkeys} />
