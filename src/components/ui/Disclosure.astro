---
/**
 * A <details> disclosure that springs open and whose content fades with it.
 *
 * The summary carries `list-none` and hides WebKit's own marker, since the
 * marker is Toggle.astro. The open/close motion is JS: `scripts/disclosure.ts`
 * animates the panel's height and opacity from a spring's curve, and keeps
 * `open` on the element until the close has finished so the content stays
 * rendered. Without the script the UA toggles as it always did.
 *
 * `overflow: hidden` on the panel does two jobs: it clips the collapsing box,
 * and it contains the content's top margin, so a closed job leaves no stray gap
 * behind.
 *
 * `openOnHover` hands the row to the pointer: entering opens it, leaving closes
 * it, and a click no longer toggles (Enter and Space still do). It only applies
 * where the pointer can rest — see `scripts/disclosure.ts`.
 *
 * Pass the summary row through the `summary` slot; everything else is content.
 */
interface Props {
  class?: string
  /** open and close with the pointer instead of a click */
  openOnHover?: boolean
}

const { class: className, openOnHover = false } = Astro.props
---

<details class={className} data-disclosure data-disclosure-hover={openOnHover ? '' : undefined}>
  <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-900">
    <slot name="summary" />
  </summary>
  <div data-disclosure-panel class="overflow-hidden">
    <slot />
  </div>
</details>

<script>
  import '@/scripts/disclosure'
</script>
