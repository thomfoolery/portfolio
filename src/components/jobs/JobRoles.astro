---
import LeaderRow from './LeaderRow.astro'
import type { Job } from '@/data/jobs'

/**
 * The roles of one job, indented past the 2ch the [+] / [-] marker spends in
 * the summary row: halved below the `wide` breakpoint, where the text reflows
 * at 12px. A role with a value prints the leader between the two.
 *
 * The class names are written out rather than interpolated: Tailwind only sees
 * a class if it appears in the source literally.
 */
interface Props {
  job: Job
}

const { job } = Astro.props

const roleIndent = 'ml-[2ch] wide:ml-[4ch]'
---

<ul class="mt-1">
  {job.roles.map((role) => (
    <li>
      {role.value ? (
        <LeaderRow label={role.label} value={role.value} class={roleIndent} />
      ) : (
        <p class:list={['leading-loose', roleIndent]}>{role.label}</p>
      )}
    </li>
  ))}
</ul>
