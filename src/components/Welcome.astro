---
import Section from '@/components/Section.astro'
import ArtHtml from '@/components/ArtHtml.astro'
import Link from '@/components/ui/Link.astro'

import { blockArt } from '@/data/art'
---

<Section id="welcome" labelledby="welcome-title" class="overflow-clip mt-4 wide:mt-8 scroll-mt-1">
  <p class="leading-loose">
    <span class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip" data-reveal>
      Hi,
    </span>{' '}
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="50% 20%"
    >
      My name is <span class="text-green-900">Thomas Yuill</span>.
    </span>
  </p>
  <p class="leading-loose">
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="50% 30%"
    >
      I am a <span class="text-green-900">designer</span> and{' '}
      <span class="text-green-900">engineer</span> and I currently work at{' '}
      <Link href="https://livekit.com/" title="Day job!!" external>
        LiveKit ➚
      </Link>
      .
    </span>
  </p>
  <p class="mt-4 leading-loose">
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="50% 35%"
    >
      I enjoy building dynamic, accessible,
    </span>{' '}
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      and aesthetic web experiences powered with
    </span>{' '}
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="20% 45%"
    >
      real-time data/media.
    </span>
  </p>
  <p class="mt-4 leading-loose">
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="50% 35%"
    >
      If I have free time, you'll find me
    </span>
    <span
      class="block mt-1 ml-1 wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      * reading a great book
    </span>
    <span
      class="block ml-1 wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      * organizing a new adventure
    </span>
    <span
      class="block ml-1 wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      * breaking, fixing or building something
    </span>
    <span
      class="block ml-1 wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="20% 45%"
    >
      * searching for new grass to touch
    </span>
  </p>

  <ArtHtml art={blockArt.prism} fullWidth scrollReveal class="my-6" />

  <div class="flex max-wide:flex-col gap-3 max-wide:gap-2 wide:ml-2">
    <div class="flex-1">
      <p
        data-reveal
        data-reveal-range="40% 20%"
        class="mb-1 leading-loose wide:h-[1.8em] wide:break-all wide:overflow-clip"
      >
        Shoot me a line on
      </p>
      <ul class="ml-[1ch]">
        <li
          data-reveal
          data-reveal-range="30% 30%"
          class="text-green-300 wide:h-[1.8em] wide:break-all wide:overflow-clip"
        >
          [g]{' '}
          <Link href="https://github.com/thomfoolery" title="Read the source, Luke" external>
            github ➚
          </Link>
        </li>
        <li
          data-reveal
          data-reveal-range="20% 40%"
          class="text-green-300 wide:h-[1.8em] wide:break-all wide:overflow-clip"
        >
          [l]{' '}
          <Link href="https://www.linkedin.com/in/thomasyuill/" title="Very professional" external>
            linkedin ➚
          </Link>
        </li>
      </ul>
    </div>
    <div class="flex-1">
      <p
        data-reveal
        data-reveal-range="40% 20%"
        class="mb-1 leading-loose wide:h-[1.8em] wide:break-all wide:overflow-clip"
      >
        While you're at it
      </p>
      <ul class="ml-[1ch]">
        <li
          data-reveal
          data-reveal-range="30% 30%"
          class="wide:h-[1.8em] wide:break-all wide:overflow-clip"
        >
          [2]{' '}
          <Link href="#experience" title="Where I've been">
            browse my jobs
          </Link>
        </li>
        <li
          data-reveal
          data-reveal-range="20% 40%"
          class="wide:h-[1.8em] wide:break-all wide:overflow-clip"
        >
          [3]{' '}
          <Link href="#honors" title="Shiny things">
            gaze upon my honors
          </Link>
        </li>
      </ul>
    </div>
  </div>
</Section>

<script>
  import '@/scripts/scroll-reveal'
</script>
