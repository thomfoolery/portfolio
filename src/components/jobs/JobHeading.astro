---
import Toggle from '@/components/ui/Toggle.astro'
import { RULE, SPACE } from '@/data/grid'
import type { Job } from '@/data/jobs'

interface Props {
  job: Job
  class?: string
}

const { job, class: className } = Astro.props
---

<h3
  class:list={['flex overflow-clip font-bold', className]}
  data-reveal
  data-reveal-range="50% 10%"
>
  <Toggle />
  <span class="whitespace-pre">
    <time datetime={job.from.datetime} class="text-green-900">
      {job.from.label}
    </time>{' '}
    -{' '}
    <span class="text-green-900">
      {job.to.datetime ? <time datetime={job.to.datetime}>{job.to.label}</time> : job.to.label}
    </span>
    {SPACE}
  </span>
  <span class="grow overflow-hidden whitespace-nowrap text-green-100" aria-hidden="true">
    {RULE}
  </span>
  <span class="whitespace-pre">
    {SPACE}
    <span class="text-green-900">{job.company}</span>
  </span>
</h3>
