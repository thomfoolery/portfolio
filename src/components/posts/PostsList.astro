---
import { GAP } from '@/data/grid'
import { posts } from './posts'
import ArtHtml from '@/components/ArtHtml.astro'
import Section from '@/components/Section.astro'

import { blockArt } from '@/data/art'
---

<Section id="posts" labelledby="posts-title">
  <h2 id="posts-title" class="sr-only">
    Posts
  </h2>

  <ArtHtml art={blockArt.posts} />

  <ol class="mt-2">
    {posts.map((post) => (
      <li class="mt-2 ml-3">
        <article>
          <h3 class="whitespace-pre">
            <time datetime={post.datetime} class="text-green-900">
              {post.date}
            </time>
            {GAP}
            <a href={post.href} title={post.linkTitle}>
              {post.title} ➚
            </a>
          </h3>
          <p class="mt-1 ml-6">{post.blurb}</p>
        </article>
      </li>
    ))}
  </ol>

  <p class="mt-3 text-center">
    <a href="https://thomasyuill.com/posts" title="Moar" class="no-underline">
      [ see all posts ]
    </a>
  </p>
</Section>
