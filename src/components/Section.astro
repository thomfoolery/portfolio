---
import { cn } from '@/lib/utils'

/**
 * One panel of the page. The element is configurable so the header and footer
 * share the sections' frame without pretending to be `<section>`s. The space
 * between panels is the caller's.
 *
 * Each panel is its own 72-column frame, centred, as the nav is: there is no
 * page-wide wrapper. Below the `wide` breakpoint it takes the full width, and
 * the text reflows.
 */
interface Props {
  as?: 'section' | 'header' | 'footer'
  id?: string
  labelledby?: string
  class?: string
}

const { as: Tag = 'section', id, labelledby, class: className } = Astro.props
---

<Tag id={id} aria-labelledby={labelledby} class={cn(['px-1', className])}>
  {/* The frame: the full width on a phone, 72 columns centred from `wide` up.
      w-full keeps it from sizing to its content, where a job's rule is 72
      unbreakable columns and would widen a phone's page. It is a flex column so
      its children's margins never collapse through it. */}
  <div class="mx-auto flex w-full flex-col wide:w-[72ch]">
    <slot />
  </div>
</Tag>
