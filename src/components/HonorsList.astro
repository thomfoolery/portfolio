---
import { GAP } from '@/data/frame'
import { honors } from '@/data/honors'

/** Measures are named here, not in the data, so Tailwind still sees them. */
const measures = {
  48: 'max-w-[48ch]',
  52: 'max-w-[52ch]',
  56: 'max-w-[56ch]',
} as const
---

<ol class="mt-3 [&>li+li]:mt-2">
  {honors.map((honor) => (
    <li class="pl-2">
      <!-- prettier-ignore -->
      <h3 class="whitespace-pre"><time datetime={honor.datetime} class="text-green-900">{honor.date}</time>{GAP}{honor.href ? <a href={honor.href}>{honor.title} ➚</a> : <span class="text-green-900">{honor.title}</span>}</h3>
      <p class:list={['mt-1 ml-[11ch]', measures[honor.measure]]}>{honor.blurb}</p>
    </li>
  ))}
</ol>
