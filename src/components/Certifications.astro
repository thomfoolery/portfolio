---
import { GAP } from '@/data/grid'
import { honors } from '@/data/honors'
import { recommendations } from '@/data/recommendations'
import { blockArt } from '@/data/art'
import ArtHtml from '@/components/ArtHtml.astro'
import Section from '@/components/Section.astro'
import Link from '@/components/ui/Link.astro'
import Prompt from '@/components/ui/Prompt.astro'
import ShowMore from '@/components/ui/ShowMore.astro'

import Table from '@/components/ui/Table.astro'
import Td from '@/components/ui/Td.astro'
import Tr from '@/components/ui/Tr.astro'

/** Measures are named here, not in the data, so Tailwind still sees them. */
const measures = {
  48: 'max-w-[48ch]',
  52: 'max-w-[52ch]',
  56: 'max-w-[56ch]',
} as const
---

<Section id="honors" labelledby="honors-title" class="mt-8">
  <h2 id="honors-title" class="sr-only font-bold">
    Honors, awards &amp; certifications
  </h2>

  <ArtHtml art={blockArt.honors} scrollReveal class="mt-1" />

  <ol class="mt-3 [&>li+li]:mt-2">
    {honors.map((honor, index) => (
      <li
        class="wide:pl-2"
        data-reveal="fade"
        data-reveal-range="80% 10%"
        data-folded={index > 2 ? '' : undefined}
      >
        <h3 class="whitespace-pre max-wide:whitespace-pre-wrap font-bold">
          <time datetime={honor.datetime} class="text-green-900">
            {honor.date}
          </time>
          {GAP}
          {honor.href ? (
            <Link href={honor.href}>{honor.title} ➚</Link>
          ) : (
            <span class="text-green-900">{honor.title}</span>
          )}
        </h3>
        <p class:list={['mt-1 ml-[2ch] wide:ml-[9ch] leading-loose', measures[honor.measure]]}>
          {honor.blurb}
        </p>
      </li>
    ))}
  </ol>

  <ShowMore />

  <Prompt class="mt-12">cat recommendations.md</Prompt>

  <Table class="mt-0.5">
    <Tr>
      <Td heading="Linkedin Recommendations" colSpan={3} />
    </Tr>
    {recommendations.map((rec) => (
      <Tr>
        <Td heading={rec.name}>{rec.title.toLowerCase()}</Td>
        <Td heading={`${rec.company}, ${rec.year}`} colSpan={2}>
          "{rec.quote}"<br />
        </Td>
      </Tr>
    ))}
  </Table>
</Section>
