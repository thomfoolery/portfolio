---
import JobHeading from './JobHeading.astro'
import JobRoles from './JobRoles.astro'
import type { Job } from '@/data/jobs'

interface Props {
  job: Job
  class?: string
}

const { job, class: className } = Astro.props
---

<style>
  .scroll-animation {
    animation-fill-mode: both;
    animation-name: reveal;
    animation-timing-function: step(72);
    animation-timeline: view(50% 10%);
    overflow: clip;
  }

  @keyframes reveal {
    0% {
      width: 0;
    }
    100% {
      width: 100%;
    }
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes slideInLeft {
    0% {
      transform: translateX(10%);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>

<li class:list={['scroll-animation mt-1', className]}>
  <details>
    <summary>
      <JobHeading job={job} />
    </summary>
    <JobRoles job={job} />
  </details>
</li>
