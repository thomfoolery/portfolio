---
import { GAP } from '@/data/grid'
import { honors } from '@/data/honors'
import { blockArt } from '@/data/art'
import ArtHtml from '@/components/ArtHtml.astro'
import Section from '@/components/Section.astro'

/** Measures are named here, not in the data, so Tailwind still sees them. */
const measures = {
  48: 'max-w-[48ch]',
  52: 'max-w-[52ch]',
  56: 'max-w-[56ch]',
} as const
---

<style>
  .scroll-animation {
    animation-fill-mode: both, both;
    animation-name: open, fadeIn;
    animation-timing-function: ease-out, linear;
    animation-timeline: view(80% 10%);
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes slide {
    0% {
      transform: translateX(10%);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>

<Section id="honors" labelledby="honors-title">
  <h2 id="honors-title" class="sr-only">
    Honors, awards &amp; certs
  </h2>

  <ArtHtml art={blockArt.honors} />

  <ol class="mt-3 [&>li+li]:mt-2">
    {honors.slice(0, 3).map((honor) => (
      <li class="pl-2 scroll-animation">
        <h3 class="whitespace-pre">
          <time datetime={honor.datetime} class="text-green-900">
            {honor.date}
          </time>
          {GAP}
          {honor.href ? (
            <a href={honor.href}>{honor.title} ➚</a>
          ) : (
            <span class="text-green-900">{honor.title}</span>
          )}
        </h3>
        <p class:list={['mt-1 ml-[9ch]', measures[honor.measure]]}>{honor.blurb}</p>
      </li>
    ))}
  </ol>

  <p class="text-center mt-2">
    <button type="button" class="hover:text-green-900 cursor-pointer transition-color">
      [ show more ]
    </button>
  </p>
</Section>
