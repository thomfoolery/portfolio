---
import JobItem from './JobItem.astro'
import { jobs } from '@/data/jobs'
import ArtHtml from '@/components/ArtHtml.astro'
import Section from '@/components/Section.astro'

import { blockArt } from '@/data/art'
---

<Section id="experience" labelledby="experience-title">
  <h2 id="experience-title" class="sr-only">
    Jobs
  </h2>

  <ArtHtml art={blockArt.experience} class="mt-3" />

  <!-- every job after the first is spaced away by one line while the rows are collapsed -->
  <ol class="mt-3">
    {jobs.slice(0, 3).map((job) => (
      <JobItem job={job} />
    ))}
  </ol>

  <p class="text-center mt-2">
    <button type="button" class="hover:text-green-900 cursor-pointer transition-color">
      [ show more ]
    </button>
  </p>
</Section>
