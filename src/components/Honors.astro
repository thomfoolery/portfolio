---
import { GAP } from '@/data/grid'
import { honors } from '@/data/honors'
import { blockArt } from '@/data/art'
import ArtHtml from '@/components/ArtHtml.astro'
import Section from '@/components/Section.astro'
import Link from '@/components/ui/Link.astro'

/** Measures are named here, not in the data, so Tailwind still sees them. */
const measures = {
  48: 'max-w-[48ch]',
  52: 'max-w-[52ch]',
  56: 'max-w-[56ch]',
} as const
---

<Section id="honors" labelledby="honors-title">
  <h2 id="honors-title" class="sr-only font-bold scroll-mt-1">
    Honors, awards &amp; certifications
  </h2>

  <ArtHtml art={blockArt.honors} scrollReveal />

  <ol class="mt-3 [&>li+li]:mt-2 font-extralight">
    {honors.map((honor, index) => (
      <li
        class="pl-2"
        data-reveal="fade"
        data-reveal-range="80% 10%"
        data-more={index > 2 ? '' : undefined}
        data-folded={index > 2 ? '' : undefined}
      >
        <h3 class="whitespace-pre font-bold">
          <time datetime={honor.datetime} class="text-green-900">
            {honor.date}
          </time>
          {GAP}
          {honor.href ? (
            <Link href={honor.href}>{honor.title} ➚</Link>
          ) : (
            <span class="text-green-900">{honor.title}</span>
          )}
        </h3>
        <p class:list={['mt-1 ml-[9ch] font-extralight leading-2', measures[honor.measure]]}>
          {honor.blurb}
        </p>
      </li>
    ))}
  </ol>

  <!-- the folded rows ship hidden; Base.astro's noscript undoes that for a reader
       without scripts, and hides this row instead -->
  <p class="text-center mt-2 font-extralight leading-[2]" data-show-more-row>
    <button
      type="button"
      class="hover:text-green-900 cursor-pointer transition-color"
      data-show-more
    >
      [ show more ]
    </button>
  </p>
</Section>
