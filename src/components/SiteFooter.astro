---
import ArtHtml from './ArtHtml.astro'
import { RULE } from '@/data/frame'

interface Props {
  /** The wordmark, and on the index page the ghoul, arrive as one fragment. */
  art: string
}

const { art } = Astro.props
---

<footer class="mt-[100dvh]">
  <p class="ml-[18ch]">20+ GLORIOUS YEARS OF PUSHING PIXELS</p>
  <!-- prettier-ignore -->
  <p class="mt-1 ml-[24ch]"><span class="text-green-600" aria-hidden="true">-+-</span> nothing is real <span class="text-green-600" aria-hidden="true">-+-</span></p>
  <ArtHtml html={art} />
  <!-- prettier-ignore -->
  <p class="flex text-green-600"><span class="whitespace-pre" aria-hidden="true">.:[ <span class="text-green-900">127.0.0.1</span> ]:</span><span class="grow overflow-hidden whitespace-nowrap" aria-hidden="true">{RULE}</span><span class="whitespace-pre" aria-hidden="true">:[ <span class="text-green-900">:31337</span> ]:.</span></p>
  <p class="sr-only">
    <small>&copy; Thomas Yuill</small>
  </p>
</footer>
