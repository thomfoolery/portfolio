---
import Section from '@/components/Section.astro'
import ArtHtml from '@/components/ArtHtml.astro'
import Link from '@/components/ui/Link.astro'

import { blockArt } from '@/data/art'
---

<Section id="welcome" labelledby="welcome-title" class="overflow-clip mt-8 scroll-mt-1">
  <p class="font-extralight leading-loose">
    <div class="h-[1.8em] break-all overflow-clip" data-reveal>
      Hi,
    </div>
    <div class="h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="50% 20%">
      My name is <span class="text-green-900">Thomas Yuill</span>.
    </div>
  </p>
  <p class="font-extralight leading-loose">
    <div class="h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="50% 30%">
      I am a <span class="text-green-900">designer</span> and{' '}
      <span class="text-green-900">engineer</span> and I currently work at{' '}
      <Link href="https://livekit.com/" title="Day job!!" external>
        LiveKit ➚
      </Link>
      .
    </div>
  </p>
  <p class="mt-4 mx-auto font-extralight leading-loose">
    <div class="h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="50% 35%">
      I enjoy building dynamic, accessible,
    </div>
    <div class="h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="35% 40%">
      and aesthetic web experiences powered with
    </div>
    <div class="h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="20% 45%">
      real-time data/media.
    </div>
  </p>
  <p class="mt-4 mx-auto font-extralight leading-loose">
    <div class="h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="50% 35%">
      If I have free time, you'll find me
    </div>
    <div
      class="mt-1 ml-1 h-[1.8em] break-all overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      * reading a great book
    </div>
    <div class="ml-1 h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="35% 40%">
      * organizing a new adventure
    </div>
    <div class="ml-1 h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="35% 40%">
      * breaking, fixing or building something
    </div>
    <div class="ml-1 h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="20% 45%">
      * searching for new grass to touch
    </div>
  </p>

  <ArtHtml art={blockArt.prism} scrollReveal class="my-6" />

  <div class="flex gap-3 ml-2">
    <div class="flex-1">
      <p
        data-reveal
        data-reveal-range="40% 20%"
        class="mb-1 font-extralight leading-loose h-[1.8em] break-all overflow-clip"
      >
        Shoot me a line on
      </p>
      <ul class="ml-[1ch] font-extralight">
        <li
          data-reveal
          data-reveal-range="30% 30%"
          class="text-green-300 h-[1.8em] break-all overflow-clip"
        >
          [g]{' '}
          <Link href="https://github.com/thomfoolery" title="Read the source, Luke" external>
            github ➚
          </Link>
        </li>
        <li
          data-reveal
          data-reveal-range="20% 40%"
          class="text-green-300 h-[1.8em] break-all overflow-clip"
        >
          [l]{' '}
          <Link href="https://www.linkedin.com/in/thomasyuill/" title="Very professional" external>
            linkedin ➚
          </Link>
        </li>
      </ul>
    </div>
    <div class="flex-1">
      <p
        data-reveal
        data-reveal-range="40% 20%"
        class="mb-1 font-extralight leading-loose h-[1.8em] break-all overflow-clip"
      >
        While you're at it
      </p>
      <ul class="ml-[1ch] font-extralight">
        <li data-reveal data-reveal-range="30% 30%" class="h-[1.8em] break-all overflow-clip">
          [2]{' '}
          <Link href="#experience" title="Where I've been">
            browse my jobs
          </Link>
        </li>
        <li data-reveal data-reveal-range="20% 40%" class="h-[1.8em] break-all overflow-clip">
          [3]{' '}
          <Link href="#honors" title="Shiny things">
            gaze upon my honors
          </Link>
        </li>
      </ul>
    </div>
  </div>
</Section>

<script>
  import '@/scripts/scroll-reveal'
</script>
