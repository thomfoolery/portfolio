---
import { renderFragment } from '@/lib/art'
import type { SectionArtItem } from '@/data/art'

/**
 * Renders one art block from its two arrays: characters and colours. The art is
 * build-time constant, so injecting the generated markup is safe — this is the
 * site's only `set:html`, and the exemption is scoped to it so the rule stays
 * armed for anything that could carry input.
 *
 * The wrapper is the block: it takes the caller's classes, the reveal and the
 * glitch. In dev it is also positioned and shrink-wrapped, so the editor trigger
 * has a corner to hang on.
 *
 * `scrollReveal` fades the block in on the page's one reveal script. Below the
 * `wide` breakpoint nothing reveals, so the art is just there; that includes
 * `hoverReveal`, since a phone has no hover to reveal it with.
 *
 * The art is sized by `--art-size` (main.css), not the text: it stays 72 columns
 * at any width, while the text stops shrinking at 12px.
 *
 * A block that glitches gets a second copy of itself, `art-ghost`, made by
 * `scripts/glitch.ts` as it starts: parked over the real art and clipped to a
 * band, so a slice can be displaced without giving the rows boxes (which stops
 * the block glyphs abutting). It is cloned rather than rendered, because a copy
 * in the markup would double the art's bytes. `glitch` defaults to `scrollReveal`:
 * the block glitches while the page scrolls. `glitch="loop"` glitches on its own
 * instead, page moving or not.
 */
interface Props {
  art: SectionArtItem
  fullWidth?: boolean
  hoverReveal?: boolean
  scrollReveal?: boolean
  glitch?: boolean | 'loop'
  class?: string
}

const {
  art,
  fullWidth = false,
  scrollReveal = false,
  hoverReveal = false,
  glitch = scrollReveal,
  class: className,
} = Astro.props
const dev = import.meta.env.DEV
const fragment = renderFragment(
  `class="relative text-(length:--art-size) leading-tight text-green-600 overflow-clip" aria-hidden="true"`,
  art,
)
---

{/* eslint-disable astro/no-set-html-directive -- art is constant, generated from src/data/art */}
<div
  class:list={[
    fullWidth && 'wide:-mx-1',
    hoverReveal &&
      'opacity-10 hover:opacity-100 max-wide:opacity-100 duration-200 hover:duration-500 transition-opacity',
    className,
  ]}
  data-glitch={glitch === 'loop' ? 'loop' : glitch ? '' : undefined}
  data-reveal={scrollReveal ? 'fade' : undefined}
  data-reveal-range={scrollReveal ? '50% 20%' : undefined}
  data-art-frame={dev ? '' : undefined}
  data-art-path={dev ? art.path : undefined}
  style={dev ? 'position:relative;width:fit-content' : undefined}
  set:html={fragment}
/>
{/* eslint-enable astro/no-set-html-directive */}

<style>
  /* The ghost is a whole copy of the art, parked over it and clipped to nothing
     until a burst shows a band of it. `scripts/glitch.ts` moves the band and the
     copy, so a slice of the illustration tears on its own. */
  :global(.art-ghost) {
    position: absolute;
    inset: 0;
    display: block;
    white-space: pre;
    pointer-events: none;
    visibility: hidden;
  }
</style>

<script>
  import '@/scripts/glitch'
</script>
