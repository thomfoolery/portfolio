---
import JobItem from './JobItem.astro'
import { jobs } from '@/data/jobs'
import ArtHtml from '@/components/ArtHtml.astro'
import Section from '@/components/Section.astro'

import { blockArt } from '@/data/art'
---

<Section id="experience" labelledby="experience-title">
  <h2 id="experience-title" class="sr-only font-bold scroll-mt-1">
    Jobs
  </h2>

  <ArtHtml art={blockArt.experience} scrollReveal class="mt-3" />

  <p class="mt-2 ml-1.5" data-reveal="fade" data-reveal-range="50% 0%">
    <span class="pointer-coarse:hidden">Hover</span>
    <span class="pointer-fine:hidden">Click</span> to open
  </p>

  <ol class="font-extralight">
    {jobs.map((job, index) => (
      <JobItem job={job} more={index > 2} openOnHover />
    ))}
  </ol>

  <!-- the folded rows ship hidden; Base.astro's noscript undoes that for a reader
       without scripts, and hides this row instead -->
  <p class="text-center mt-2 font-extralight leading-[2]" data-show-more-row>
    <button
      type="button"
      class="hover:text-green-900 cursor-pointer transition-color"
      data-show-more
    >
      [ show more ]
    </button>
  </p>
</Section>
