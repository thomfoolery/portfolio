---
import Section from './Section.astro'
import ArtHtml from '@/components/ArtHtml.astro'
import { blockArt } from '@/data/art'

interface Props {}

const year = new Date().getFullYear()
---

<Section class="overflow-clip">
  <ArtHtml art={blockArt.eyes} scrollReveal />

  <p class="font-medium mt-2 leading-[2]">
    <div class="ml-5 h-[1.8em] break-all overflow-clip" data-reveal data-reveal-range="30% 20%">
      20+ glorious years pushing pixels and...
    </div>
  </p>

  <p class="font-black mt-1 leading-[2]">
    <div
      class="ml-16 h-[1.8em] break-all overflow-clip text-green-900"
      data-reveal
      data-reveal-range="20% 40%"
    >
      NOTHING IS REAL ;)
    </div>
  </p>
</Section>

<Section as="footer" align="bottom" class="pb-0">
  <ArtHtml art={blockArt.footer} hoverReveal class="peer ml-4" />

  <p class="text-right my-1 font-extralight leading-[2] peer-hover:opacity-100 opacity-10 duration-200 peer-hover:duration-500 transition-opacity">
    <small class="bg-clip-text text-transparent bg-linear-to-r from-green-100 via-green-900 to-green-100 font-extralight [font-size:inherit]">
      &copy; Thomas Yuill {year}
    </small>
  </p>
</Section>
