---
import { renderFragment } from '@/lib/art'
import type { SectionArtItem } from '@/data/art'

/**
 * Renders one art block from its two arrays: characters and colours. The art is
 * build-time constant, so injecting the generated markup is safe — this is the
 * site's only `set:html`, and the exemption is scoped to it so the rule stays
 * armed for anything that could carry input.
 *
 * `display: contents` keeps the wrapper out of the layout, so the art behaves as
 * a direct child of whatever section holds it. In dev the wrapper becomes a real
 * box instead: a `contents` box has no corner to hang the editor trigger on.
 */
interface Props {
  art: SectionArtItem
  hoverReveal?: boolean
  scrollReveal?: boolean
  class?: string
}

const { art, scrollReveal = false, hoverReveal = false, class: className } = Astro.props
const dev = import.meta.env.DEV
const fragment = renderFragment(
  `class="leading-none text-green-600" aria-hidden="true"`.trimEnd(),
  art,
)
---

<style>
  .scroll-animation-fade {
    animation-fill-mode: both;
    animation-name: fadeIn;
    animation-timing-function: linear;
    animation-timeline: view(20% 30%);
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
</style>

{/* eslint-disable astro/no-set-html-directive -- art is constant, generated from src/data/art */}
<div
  class:list={[
    dev ? undefined : 'contents',
    scrollReveal && 'scroll-animation-fade',
    hoverReveal &&
      'opacity-10 hover:opacity-100 duration-200 hover:duration-500 transition-opacity',
    className,
  ]}
  style={dev ? 'position:relative;width:fit-content' : undefined}
  data-art-frame={dev ? '' : undefined}
  data-art-path={dev ? art.path : undefined}
  set:html={fragment}
/>
{/* eslint-enable astro/no-set-html-directive */}
