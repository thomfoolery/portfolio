---
import { GAP } from '@/data/grid'
import { posts } from '@/data/posts'
import ArtHtml from '@/components/ArtHtml.astro'
import Section from '@/components/Section.astro'
import Link from '@/components/ui/Link.astro'

import { blockArt } from '@/data/art'
---

<Section id="posts" labelledby="posts-title">
  <h2 id="posts-title" class="sr-only font-bold">
    Posts
  </h2>

  <ArtHtml art={blockArt.posts} />

  <ol class="mt-2 font-extralight">
    {posts.map((post) => (
      <li class="mt-2 ml-3">
        <article>
          <h3 class="whitespace-pre font-bold">
            <time datetime={post.datetime} class="text-green-900">
              {post.date}
            </time>
            {GAP}
            <Link href={post.href} title={post.linkTitle}>
              {post.title} ➚
            </Link>
          </h3>
          <p class="mt-1 ml-6 font-extralight leading-[2]">{post.blurb}</p>
        </article>
      </li>
    ))}
  </ol>

  <p class="mt-3 text-center font-extralight leading-[2]">
    <Link href="https://thomasyuill.com/posts" title="Moar" class="no-underline">
      [ see all posts ]
    </Link>
  </p>
</Section>
