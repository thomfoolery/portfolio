---
import Nav from '@/components/Nav.astro'
import Base from '@/layouts/Base.astro'
import Header from '@/components/Header.astro'
import WhoAmI from '@/components/WhoAmI.astro'
import Experience from '@/components/Experience.astro'
import Work from '@/components/Work.astro'
import Certifications from '@/components/Certifications.astro'
import Footer from '@/components/Footer.astro'
import ArtHtml from '@/components/ArtHtml.astro'
import { blockArt } from '@/data/art'
---

<Base
  title="THOM YUILL | ux developer | design technologist | Waterloo, Canada"
  description="Thom Yuill - web developer and UX designer based out of Waterloo, Canada."
>
  <Nav />
  <Header />

  <main>
    <Work />
    <WhoAmI />

    <div class="bg-green-100/25 border-y border-green-100 mt-8">
      <div class="max-w-[72ch] mx-auto">
        <ArtHtml art={blockArt.prism} fullWidth scrollReveal />
      </div>
    </div>

    <Experience />
    <Certifications />
  </main>

  <Footer />
</Base>
