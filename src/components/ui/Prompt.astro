---
/**
 * A line of the terminal session the page is written as: the prompt, and the
 * command typed at it, which is the slot.
 */
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<p class={className}>
  <code>
    root@thomfoolery:~#{' '}
    <span class="font-black text-green-900">
      <slot />
    </span>
  </code>
</p>
