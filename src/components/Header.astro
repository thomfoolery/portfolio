---
import Section from './Section.astro'
import ArtHtml from '@/components/ArtHtml.astro'
import { blockArt } from '@/data/art'
import Table from '@/components/ui/Table.astro'
import Td from '@/components/ui/Td.astro'
import Tr from '@/components/ui/Tr.astro'

// The first job's year, and the years since as of the build.
const since = 2000
const years = new Date().getFullYear() - since
---

<Section as="header" class="pt-1">
  <h1 class="sr-only font-bold">Thom Yuill - UX developer and design engineer</h1>
  <ArtHtml art={blockArt.header} glitch="loop" />

  <Table class="mt-1">
    <Tr>
      <Td heading="Location">waterloo on, canada</Td>
      <Td heading="Timezone">eastern (utc-5/-4)</Td>
      <Td heading="Vehicle          year">{'suzuki dr650     2008'}</Td>
    </Tr>
    <Tr>
      <Td heading="Operator profile" colSpan={2}>
        ux developer / design engineer
      </Td>
      <Td heading="Shipping">since {`${since}     ${years} yrs`}</Td>
    </Tr>
  </Table>
</Section>
