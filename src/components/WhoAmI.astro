---
import Section from '@/components/Section.astro'
import Link from '@/components/ui/Link.astro'
---

<Section id="whoami" labelledby="whoami-title" class="overflow-clip scroll-mt-1 mt-4">
  <h2 id="whoami-title" class="sr-only">
    Who Am I?
  </h2>

  <p class="leading-loose mt-1">
    <span class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip" data-reveal>
      ---
    </span>
    <span class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip mt-1" data-reveal>
      Hi,
    </span>{' '}
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="50% 20%"
    >
      My name is <span class="text-green-900 font-black">Thomas Yuill</span>.
    </span>
  </p>
  <p class="leading-loose">
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="50% 30%"
    >
      I am a <span class="text-green-900 font-black">designer</span> and{' '}
      <span class="text-green-900 font-black">engineer</span> and I currently work at{' '}
      <Link external href="https://livekit.com/" title="Day job!!" class="font-black">
        LiveKit
      </Link>
      .
    </span>
  </p>
  <p class="mt-2 leading-loose">
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="50% 35%"
    >
      I enjoy building dynamic, accessible,
    </span>{' '}
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      and aesthetic web experiences powered with
    </span>{' '}
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="20% 45%"
    >
      real-time data/media.
    </span>
  </p>
  <p class="mt-2 leading-loose">
    <span
      class="wide:block wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="50% 35%"
    >
      If I have free time, you'll find me
    </span>
    <span
      class="block mt-1 ml-1 wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      * reading a great book
    </span>
    <span
      class="block ml-1 wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      * organizing a new adventure
    </span>
    <span
      class="block ml-1 wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="35% 40%"
    >
      * breaking, fixing or building something
    </span>
    <span
      class="block ml-1 wide:h-[1.8em] wide:break-all wide:overflow-clip"
      data-reveal
      data-reveal-range="20% 45%"
    >
      * searching for new grass to touch
    </span>
  </p>
</Section>
