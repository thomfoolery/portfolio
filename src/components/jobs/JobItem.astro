---
import JobHeading from './JobHeading.astro'
import JobRoles from './JobRoles.astro'
import Disclosure from '@/components/ui/Disclosure.astro'
import type { Job } from '@/data/jobs'

interface Props {
  job: Job
  /** folded away behind the section's "show more" until it is clicked */
  more?: boolean
  class?: string
}

const { job, more = false, class: className } = Astro.props
---

<li
  class:list={['mt-1', className]}
  data-more={more ? '' : undefined}
  data-folded={more ? '' : undefined}
>
  <Disclosure>
    <JobHeading slot="summary" job={job} />
    <JobRoles job={job} />
  </Disclosure>
</li>
