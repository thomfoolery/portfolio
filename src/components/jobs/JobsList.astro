---
import JobItem from './JobItem.astro'
import { jobs } from '@/data/jobs'
import ArtHtml from '@/components/ArtHtml.astro'
import Section from '@/components/Section.astro'

import { blockArt } from '@/data/art'
---

<Section id="experience" labelledby="experience-title">
  <h2 id="experience-title" class="sr-only font-bold">
    Jobs
  </h2>

  <ArtHtml art={blockArt.experience} scrollReveal class="mt-3" />

  <!-- every job after the first is spaced away by one line while the rows are collapsed -->
  <ol class="mt-3 font-extralight">
    {jobs.map((job, index) => (
      <JobItem job={job} more={index > 2} />
    ))}
  </ol>

  <!-- hidden until show-more.js runs, so the full list is the no-JS state -->
  <p class="text-center mt-2 font-extralight leading-[2]" hidden>
    <button
      type="button"
      class="hover:text-green-900 cursor-pointer transition-color"
      data-show-more
    >
      [ show more ]
    </button>
  </p>
</Section>
