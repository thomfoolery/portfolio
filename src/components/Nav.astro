---
import hotkeys from '@/scripts/hotkeys.js?raw'
import Hint from './ui/Hint.astro'
import Link from './ui/Link.astro'
import { navItems } from '@/data/nav'
---

<nav
  aria-label="Main"
  class="sticky -top-px overflow-x-clip bg-black py-0.5 z-(--z-nav) border-t border-b border-green-200"
>
  <div class="mx-auto wide:w-[72ch]">
    {/* On a touch screen each link's target is the bar's full two lines, and a
        column either side, so neighbours meet in the 2ch gap. A narrow phone
        wraps the bar, and the line between rows keeps their targets apart. The
        bar clips them sideways: the last link's would reach past the screen and
        widen a phone's page. */}
    <ul class="flex flex-wrap gap-x-[2ch] gap-y-1">
      {navItems.map((item) => (
        <li class={item.right ? 'ml-auto' : undefined}>
          {item.key && <Hint>[{item.key}]</Hint>}
          <Link
            class="relative no-underline py-[3px] px-[1ch] font-semibold pointer-coarse:before:absolute pointer-coarse:before:-inset-x-[1ch] pointer-coarse:before:top-1/2 pointer-coarse:before:h-2 pointer-coarse:before:-translate-y-1/2"
            href={item.href}
            title={item.title}
            external={item.external}
            data-key={item.key}
            aria-keyshortcuts={item.key}
          >
            {item.label}
          </Link>
        </li>
      ))}
    </ul>
  </div>
</nav>
<!-- The nav's hotkeys are the page's first client script. Inlined, so no request. -->
{/* eslint-disable-next-line astro/no-set-html-directive -- this is our own script text */}
<script is:inline set:html={hotkeys} />
