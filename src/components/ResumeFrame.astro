---
import ArtHtml from './ArtHtml.astro'
import HonorsList from './honors/HonorsList.astro'
import JobsList from './jobs/JobsList.astro'
import PostsList from './posts/PostsList.astro'
import Section from './Section.astro'
import SiteFooter from './SiteFooter.astro'
import Nav from './Nav.astro'
import type { SectionArt } from '@/data/art'

/** The structure every section of the résumé shares. */
interface Props {
  art: SectionArt
}

const { art } = Astro.props
---

<div class="w-[72ch] mx-auto">
  <div class="overflow-x-clip">
    <Section as="header" align="center">
      <h1 class="sr-only">Thom Yuill - UX developer and design engineer</h1>
      <ArtHtml html={art.header} />
    </Section>
    <Nav />
    <main>
      <slot name="welcome" />
      <Section id="posts" labelledby="posts-title" hidden>
        <h2 id="posts-title" class="sr-only">
          Posts
        </h2>
        <ArtHtml html={art.posts} />
        <PostsList />
      </Section>
      <Section id="experience" labelledby="experience-title">
        <h2 id="experience-title" class="sr-only">
          Jobs
        </h2>
        <ArtHtml html={art.experience} />
        <JobsList />
      </Section>
      <Section id="honors" labelledby="honors-title">
        <h2 id="honors-title" class="sr-only">
          Honors, awards &amp; certs
        </h2>
        <ArtHtml html={art.honors} />
        <HonorsList />
      </Section>
    </main>
    <SiteFooter art={art.footer} />
  </div>
</div>
